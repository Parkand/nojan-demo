// F:\Nexora Nojan\prisma\schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskEventType {
  CREATED
  UPDATED
  REASSIGNED
  STARTED
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  CANCELLED
  COMMENTED
  DELETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_SUBMITTED
  TASK_CHANGES_REQUESTED
  TASK_APPROVED
  TASK_CANCELLED
  TASK_COMMENTED
  TASK_DUE_SOON
  TASK_OVERDUE
  SYSTEM
  PERSONNEL_REQUEST_CREATED
  PERSONNEL_REQUEST_REPLIED
}

model User {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  createdById Int?
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  updatedById Int?
  deletedAt   DateTime? @db.DateTime(3)
  deletedById Int?

  createdBy User? @relation("User_created", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("User_updated", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy User? @relation("User_deleted", fields: [deletedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  auditUserCreated User[] @relation("User_created")
  auditUserUpdated User[] @relation("User_updated")
  auditUserDeleted User[] @relation("User_deleted")

  auditCategoryCreated Category[] @relation("Category_created")
  auditCategoryUpdated Category[] @relation("Category_updated")
  auditCategoryDeleted Category[] @relation("Category_deleted")

  auditProductCreated Product[] @relation("Product_created")
  auditProductUpdated Product[] @relation("Product_updated")
  auditProductDeleted Product[] @relation("Product_deleted")

  auditOrderCreated Order[] @relation("Order_created")
  auditOrderUpdated Order[] @relation("Order_updated")
  auditOrderDeleted Order[] @relation("Order_deleted")

  auditOrderItemCreated OrderItem[] @relation("OrderItem_created")
  auditOrderItemUpdated OrderItem[] @relation("OrderItem_updated")
  auditOrderItemDeleted OrderItem[] @relation("OrderItem_deleted")

  name                String    @db.VarChar(100)
  username            String    @unique @db.VarChar(64)
  passwordHash        String    @db.VarChar(255)
  role                Role      @default(USER)
  sessionVersion      Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.DateTime(3)

  orders    Order[] @relation("OrderOwner")
  approvals Order[] @relation("OrderApprover")

  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  reviewTasks   Task[] @relation("TaskReviewer")
  updatedTasks  Task[] @relation("TaskUpdater")
  deletedTasks  Task[] @relation("TaskDeleter")

  taskEvents    TaskEvent[]    @relation("TaskEventActor")
  notifications Notification[] @relation("NotificationRecipient")

  personnelRequestsSent     PersonnelRequest[]          @relation("PersonnelRequestSender")
  personnelRequestInbox     PersonnelRequestRecipient[] @relation("PersonnelRequestRecipientUser")
  personnelRequestReplies   PersonnelRequestReply[]     @relation("PersonnelRequestReplyAuthor")

  @@index([deletedAt])
  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  createdById Int?
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  updatedById Int?
  deletedAt   DateTime? @db.DateTime(3)
  deletedById Int?

  createdBy User? @relation("Category_created", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("Category_updated", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy User? @relation("Category_deleted", fields: [deletedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  code     String    @unique @db.VarChar(40)
  name     String    @db.VarChar(120)
  products Product[]

  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  createdById Int?
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  updatedById Int?
  deletedAt   DateTime? @db.DateTime(3)
  deletedById Int?

  createdBy User? @relation("Product_created", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("Product_updated", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy User? @relation("Product_deleted", fields: [deletedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  code       String   @unique @db.VarChar(40)
  name       String   @db.VarChar(160)
  unit       String   @db.VarChar(30)
  price      Decimal? @db.Decimal(12, 0)
  categoryId Int

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([categoryId, deletedAt])
  @@index([deletedAt])
  @@map("products")
}

model Order {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  createdById Int?
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  updatedById Int?
  deletedAt   DateTime? @db.DateTime(3)
  deletedById Int?

  createdBy User? @relation("Order_created", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("Order_updated", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy User? @relation("Order_deleted", fields: [deletedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  orderDate    DateTime  @db.Date
  userId       Int
  approvedAt   DateTime? @db.DateTime(3)
  approvedById Int?

  user       User        @relation("OrderOwner", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy User?       @relation("OrderApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@index([userId, deletedAt, createdAt])
  @@index([deletedAt, approvedAt])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  createdById Int?
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  updatedById Int?
  deletedAt   DateTime? @db.DateTime(3)
  deletedById Int?

  createdBy User? @relation("OrderItem_created", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("OrderItem_updated", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy User? @relation("OrderItem_deleted", fields: [deletedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  orderId          Int
  productId        Int
  currentStock     Decimal  @db.Decimal(12, 3)
  requiredQuantity Decimal  @db.Decimal(12, 3)
  unitPrice        Decimal? @db.Decimal(12, 0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId, deletedAt])
  @@index([productId])
  @@index([deletedAt])
  @@map("order_items")
}

model Task {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  createdById Int
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  updatedById Int?
  deletedAt   DateTime? @db.DateTime(3)
  deletedById Int?

  title       String       @db.VarChar(200)
  description String       @db.Text
  status      TaskStatus   @default(ASSIGNED)
  priority    TaskPriority @default(NORMAL)
  version     Int          @default(0)

  assigneeId Int
  reviewerId Int

  dueAt       DateTime? @db.DateTime(3)
  startedAt   DateTime? @db.DateTime(3)
  submittedAt DateTime? @db.DateTime(3)
  approvedAt  DateTime? @db.DateTime(3)
  cancelledAt DateTime? @db.DateTime(3)

  createdBy User  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("TaskUpdater", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy User? @relation("TaskDeleter", fields: [deletedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee  User  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer  User  @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  events        TaskEvent[]
  notifications Notification[]

  @@index([createdById, deletedAt, createdAt])
  @@index([assigneeId, deletedAt, status, dueAt])
  @@index([reviewerId, deletedAt, status, createdAt])
  @@index([deletedAt, status, dueAt])
  @@index([updatedById])
  @@index([deletedById])
  @@map("tasks")
}

model TaskEvent {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.DateTime(3)

  taskId  Int
  actorId Int
  type    TaskEventType

  fromStatus TaskStatus?
  toStatus   TaskStatus?
  message    String?     @db.Text
  details    Json?

  task  Task @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor User @relation("TaskEventActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId, createdAt, id])
  @@index([actorId, createdAt])
  @@map("task_events")
}

model Notification {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.DateTime(3)

  recipientId Int
  type        NotificationType
  title       String           @db.VarChar(200)
  body        String           @db.Text

  taskId             Int?
  personnelRequestId Int?
  readAt             DateTime? @db.DateTime(3)
  dedupeKey          String?   @unique @db.VarChar(191)

  recipient        User              @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  personnelRequest PersonnelRequest? @relation(fields: [personnelRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt, id])
  @@index([taskId])
  @@index([personnelRequestId])
  @@map("notifications")
}

model PersonnelRequest {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now()) @db.DateTime(3)
  senderId      Int
  senderRole    Role
  body          String   @db.Text
  submissionKey String   @unique @db.VarChar(64)

  sender        User                        @relation("PersonnelRequestSender", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipients    PersonnelRequestRecipient[]
  replies       PersonnelRequestReply[]
  notifications Notification[]

  @@index([senderId, createdAt, id])
  @@index([createdAt, id])
  @@map("personnel_requests")
}

model PersonnelRequestRecipient {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  requestId   Int
  recipientId Int
  readAt      DateTime? @db.DateTime(3)

  request   PersonnelRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient User             @relation("PersonnelRequestRecipientUser", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestId, recipientId])
  @@index([recipientId, createdAt, id])
  @@index([recipientId, readAt, createdAt])
  @@map("personnel_request_recipients")
}

model PersonnelRequestReply {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now()) @db.DateTime(3)
  requestId     Int
  authorId      Int
  body          String   @db.Text
  submissionKey String   @unique @db.VarChar(64)

  request PersonnelRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author  User             @relation("PersonnelRequestReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([requestId, createdAt, id])
  @@index([authorId, createdAt])
  @@map("personnel_request_replies")
}
